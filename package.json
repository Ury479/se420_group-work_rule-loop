{
  "name": "rule-loop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint src scripts tests *.ts *.mjs --max-warnings=0 --no-warn-ignored",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:local": "node scripts/local-db.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --import tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "env:local": "node scripts/configure-local.mjs",
    "db:migrate:test": "node --env-file=.env.test scripts/migrate.mjs",
    "db:seed:test": "node --import tsx --env-file=.env.test scripts/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@vercel/analytics": "1.6.1",
    "ai": "7.0.123",
    "better-auth": "1.7.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.49.0",
    "next": "16.2.10",
    "pg": "8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.10.1",
    "shadcn": "4.21.0",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "postcss": "8.5.28",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
