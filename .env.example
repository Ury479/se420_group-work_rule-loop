# Runtime role must not be a PostgreSQL superuser or have BYPASSRLS.
DATABASE_URL=postgresql://ruleloop_app@127.0.0.1:55432/ruleloop_dev
# Only used by migrations; never exposed to the browser.
MIGRATION_DATABASE_URL=postgresql://ruleloop@127.0.0.1:55432/ruleloop_dev
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Optional AI translation; leave empty to use the rest of the application.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4o-mini
ENABLE_ANALYTICS=false
# Shared calendar boundary for browser and server (requires rebuild when changed).
NEXT_PUBLIC_APP_TIME_ZONE=Asia/Bangkok

# Only the dedicated spending review worker consumes these variables.
# REVIEW_WORKER_DATABASE_URL=postgresql://ruleloop_review_worker:secret@127.0.0.1:55432/ruleloop_dev
# HERMES_REVIEW_URL=http://127.0.0.1:18642/v1/chat/completions
# HERMES_REVIEW_TOKEN=
